# ---------------------------------------------------------------
# Rakukun — Production Dockerfile (multi-stage, standalone output)
# ---------------------------------------------------------------
# Stage 1: dependencies
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json* ./
RUN npm ci

# Stage 2: builder
FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate
RUN npm run build

# Stage 3: runner (standalone output)
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Next.js standalone output is produced in .next/standalone
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Prisma client needs the schema at runtime for some operations; copy it too.
COPY --from=builder /app/prisma ./prisma

EXPOSE 3000

# Run as non-root if desired; keep simple for compatibility.
CMD ["node", "server.js"]
