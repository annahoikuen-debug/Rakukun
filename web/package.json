    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "lucide-react": "^0.500.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
