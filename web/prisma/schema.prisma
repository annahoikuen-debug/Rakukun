generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  memberships        Membership[]
  accounts           Account[]
  sessions           Session[]
  mfaEnabled         Boolean      @default(false)
  mfaSecret          String?
  mfaConfirmedAt     DateTime?
  recoveryCodes      MfaRecoveryCode[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Tenant {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  domain           String?            @unique
  plan             String             @default("FREE")
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripePriceId String?
  gophishUserId    Int?
  gophishApiKey    String?
  // Parent tenant for partner (agency) plans. NULL for direct customers.
  parentId         String?
  parent           Tenant?        @relation("PartnerTenants", fields: [parentId], references: [id])
  children         Tenant[]       @relation("PartnerTenants")
  memberships      Membership[]
  campaignLinks    CampaignLink[]
  employees        TargetEmployee[]
  campaigns        TrainingCampaign[]
  suppressedEmails SuppressedEmail[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      OrgRole  @default(MEMBER)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model CampaignLink {
  id                String   @id @default(cuid())
  tenantId          String
  gophishCampaignId Int
  name              String
  status            String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, gophishCampaignId])
}

model TargetEmployee {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department String
  name      String
  email     String
  createdAt DateTime         @default(now())
  results   TrainingResult[]

  @@unique([tenantId, email])
}

model TrainingCampaign {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  templateKey       String
  gophishCampaignId Int?             @unique
  gophishGroupId    Int?
  status            String           @default("SCHEDULED")
  startDate         DateTime?
  sendByDate        DateTime?
  reviewComment     String?
  results           TrainingResult[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tenantId])
}

model TrainingResult {
  id                 String           @id @default(cuid())
  trainingCampaignId String
  trainingCampaign   TrainingCampaign @relation(fields: [trainingCampaignId], references: [id], onDelete: Cascade)
  targetEmployeeId   String
  targetEmployee     TargetEmployee   @relation(fields: [targetEmployeeId], references: [id], onDelete: Cascade)
  gophishResultId    String?          @unique
  publicToken        String?          @unique
  emailSentAt        DateTime?
  isHumanClicked     Boolean          @default(false)
  clickedAt          DateTime?
  isQuizCompleted    Boolean          @default(false)
  quizCompletedAt    DateTime?
  userAgent          String?
  createdAt          DateTime         @default(now())

  @@unique([trainingCampaignId, targetEmployeeId])
  @@index([targetEmployeeId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Amazon SES Email Event Notification persistence.
// Records Bounce / Complaint / Delivery events per recipient for delivery
// reputation monitoring and automatic suppression.
model SesEvent {
  id        String   @id @default(cuid())
  eventType String   // Bounce | Complaint | Delivery
  messageId String?
  email     String
  timestamp DateTime
  payload   Json?

  @@index([email])
  @@index([eventType])
  @@index([timestamp])
}

// Suppressed recipients that must not receive further training emails.
//
// Design decision: `email` remains globally `@unique` (not composite on
// [tenantId, email]). The SES webhook has no tenant context, so it must be
// able to upsert a suppressed email by email alone. Making email globally
// unique also means a suppressed address is never re-emailed by any tenant,
// which is the safest behavior for production suppression. `tenantId` is
// optional and indexed so per-tenant suppression can be queried/enforced
// where org context is available (test-send, launch, createCampaignAction).
model SuppressedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reason    String   // hard-bounce | complaint
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// MFA recovery codes (hashed, single-use).
model MfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

// Processed Stripe webhook events for idempotency (duplicate delivery safe).
model ProcessedStripeEvent {
  id        String   @id
  type      String
  receivedAt DateTime @default(now())
}

// Audit log for security-relevant mutations and tenant switches.
// Writes are best-effort (never break the main flow if the audit write fails).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // e.g. "campaign.create", "template.delete", "tenant.switch"
  entityType String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  tenantId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId])
}